# 复制为 .env 后修改 (deploy.sh 首次运行会自动复制并生成 API_KEY)

# 网页访问端口, 浏览器打开 http://VPS的IP:8080
APP_PORT=8080
# 可选: 有域名才填 (不带 https://), 填了会自动配置 https; 不填就用 IP 访问
DOMAIN=

# 访问密钥: 网页登录用它
API_KEY=换成一串随机字符

# DeepSeek API Key (platform.deepseek.com 申请), 填了才会用 DeepSeek 分析
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 自动分析: 1 开启 / 0 关闭; 每天运行时间 (北京时间)
AUTO_ANALYSIS=1
AUTO_ANALYSIS_TIME=16:10

DB_PATH=/data/grain.db
