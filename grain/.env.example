# 复制为 .env 后修改
# 你的 DuckDNS 域名 (不带 https://)
DOMAIN=xiaoliang.duckdns.org
PUBLIC_URL=https://xiaoliang.duckdns.org
# 访问密钥: 运行 openssl rand -hex 24 生成, 网页登录用它
API_KEY=换成一串随机字符
# 可选: PushPlus 微信推送 token (pushplus.plus 微信扫码获取)
PUSHPLUS_TOKEN=
DB_PATH=/data/grain.db
# DeepSeek API Key (platform.deepseek.com 申请), 填了才会每天自动 AI 分析
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 自动分析: 1 开启 / 0 关闭; 每天运行时间 (北京时间)
AUTO_ANALYSIS=1
AUTO_ANALYSIS_TIME=16:10
